#!/bin/sh
set -eu

# macOS terminals provide pbcopy; Linux desktop sessions commonly provide one
# of the two commands below. In a browser-only/headless IDE, OSC 52 lets the
# terminal frontend transfer the selection to the user's clipboard.
if command -v pbcopy >/dev/null 2>&1; then
    exec pbcopy
fi
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
fi
if [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard
fi

payload=$(base64 | tr -d '\n')
printf '\033]52;c;%s\a' "$payload"
