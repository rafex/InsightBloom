# Etherpad con un plugin propio (ep_insightbloom_hide_delete) que oculta el boton nativo
# "Delete pad": las notas de InsightBloom son un documento oficial compartido por todo el
# evento, nadie debe poder borrarlo desde la UI. Ver infra/docker/etherpad/ para el detalle.
#
# El plugin se coloca en src/plugin_packages/ -- ahi es donde el instalador de plugins de
# Etherpad (src/static/js/pluginfw/installer.ts) busca plugins locales al arrancar, los
# symlinkea a node_modules/ y los carga como cualquier otro plugin ep_*, sin necesidad de
# publicarlo a npm ni de tocar el core.
FROM etherpad/etherpad:2.3.1

COPY --chown=1000:1000 infra/docker/etherpad/ep_insightbloom_hide_delete/ \
    /opt/etherpad-lite/src/plugin_packages/ep_insightbloom_hide_delete/
