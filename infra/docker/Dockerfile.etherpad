# Etherpad con un plugin propio (ep_insightbloom_hide_delete) que oculta el boton nativo
# "Delete pad": las notas de InsightBloom son un documento oficial compartido por todo el
# evento, nadie debe poder borrarlo desde la UI. Ver infra/docker/etherpad/ para el detalle.
#
# Se usa el mecanismo oficial de la imagen para plugins locales (bin/installLocalPlugins.sh +
# ETHERPAD_LOCAL_PLUGINS) en vez de colocar el plugin a mano en src/plugin_packages/: ese
# directorio depende de que Etherpad symlinkee el plugin a src/node_modules en runtime, y ese
# arbol no es escribible por el uid no-root que fuerza nuestro securityContext de Kubernetes.
FROM etherpad/etherpad:2.3.1

# La imagen base ya cambia a un usuario no-root (uid 1000) antes de este punto -- sin volver a
# root, ni el install (crea symlinks/archivos en src/node_modules) ni el chown de abajo pueden
# escribir fuera de lo que ese uid ya posee ("chown: Operation not permitted" en cada archivo).
USER root

COPY infra/docker/etherpad/ep_insightbloom_hide_delete/ \
    /opt/etherpad-lite/local_plugins/ep_insightbloom_hide_delete/
# El install deja algunas rutas (node_modules, plugin_packages/bookkeeping) sin el dueno
# correcto para el uid 1000 con el que corre el contenedor en runtime (securityContext del
# chart) -- sin este chown, Etherpad ni siquiera puede crear el directorio de bookkeeping de
# plugins al arrancar ("EACCES: permission denied, mkdir plugin_packages").
# HOME=/home/etherpad: como root, $HOME por defecto es /root -- pnpm resuelve su store global a
# partir de HOME, y como los node_modules existentes ya estan linkeados desde el store del
# usuario original (/home/etherpad/.local/share/pnpm/store), un HOME distinto hace que pnpm
# rechace el install entero con ERR_PNPM_UNEXPECTED_STORE.
RUN HOME=/home/etherpad ETHERPAD_LOCAL_PLUGINS=ep_insightbloom_hide_delete \
        /opt/etherpad-lite/bin/installLocalPlugins.sh && \
    chown -R 1000:1000 /opt/etherpad-lite/src /opt/etherpad-lite/local_plugins

USER 1000:1000
