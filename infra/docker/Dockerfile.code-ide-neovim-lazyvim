COPY infra/docker/insightbloom-mentor.py /usr/local/bin/insightbloom-mentor.py
COPY infra/docker/insightbloom /usr/local/bin/insightbloom
COPY infra/docker/IDE-WEB-PUBLICATION.md /usr/local/share/doc/insightbloom/IDE-WEB-PUBLICATION.md
COPY infra/docker/IDE-AI-MENTOR.md /usr/local/share/doc/insightbloom/IDE-AI-MENTOR.md
COPY infra/docker/IDE-REST-CLIENT.md /usr/local/share/doc/insightbloom/IDE-REST-CLIENT.md
COPY infra/docker/IDE-APP-PUBLICATION.md /usr/local/share/doc/insightbloom/IDE-APP-PUBLICATION.md
COPY infra/docker/seed-ide-docs.sh /usr/local/bin/seed-ide-docs.sh
RUN mkdir -p /usr/local/share/insightbloom-node-types && \
    npm install --prefix /usr/local/share/insightbloom-node-types --omit=dev @types/node && \
    chmod -R a+rX /usr/local/share/insightbloom-node-types && \
    test -x /opt/insightbloom/node-global/bin/typescript-language-server && \
    test -x /opt/insightbloom/node-global/bin/pyright-langserver && \
    test -x /opt/insightbloom/node-global/bin/vscode-html-language-server && \
    test -x /opt/insightbloom/node-global/bin/vscode-css-language-server && \
    chmod +x /usr/local/bin/seed-node-types.sh /usr/local/bin/sandbox-agent.py \
    /usr/local/bin/insightbloom-publish.py /usr/local/bin/insightbloom-mentor.py /usr/local/bin/insightbloom \
    /usr/local/bin/seed-ide-docs.sh

# Todos los directorios globales de LazyVim/plugins/config quedan legibles por cualquier
# asiento (los procesos de nvim corren como studentN/coder, nunca como root) -- solo root
# (build time) puede escribirlos, igual que /opt/insightbloom/node-global.
RUN chown -R root:root /opt/insightbloom/nvim-lazy /etc/insightbloom/nvim-lazyvim-config && \
    chmod -R a+rX /opt/insightbloom/nvim-lazy /etc/insightbloom/nvim-lazyvim-config

USER coder

EXPOSE 8079-8089

ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "/usr/local/bin/seed-node-types.sh /home/coder/workspace; /usr/local/bin/seed-ide-docs.sh /home/coder/workspace; tmux new-session -d -s main -c /home/coder/workspace nvim . ; exec ttyd -p 8080 -W --ping-interval 15 tmux attach-session -t main"]
