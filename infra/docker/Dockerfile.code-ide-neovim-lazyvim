    clone_pin https://github.com/ibhagwan/fzf-lua.git                           main   fzf-lua                       28440c741e927592877514fba3db21eb188caec8 && \
    clone_pin https://github.com/lewis6991/gitsigns.nvim.git                    main   gitsigns.nvim                 31d6fb2d618bca1482b9f274751ead5f03461408 && \
    clone_pin https://github.com/MagicDuck/grug-far.nvim.git                    main   grug-far.nvim                 0f6a5d0d7a70659b11bbcd6b3673ee0fe61b6024 && \
    clone_pin https://github.com/folke/lazydev.nvim.git                         main   lazydev.nvim                  ff2cbcba459b637ec3fd165a2be59b7bbaeedf0d && \
