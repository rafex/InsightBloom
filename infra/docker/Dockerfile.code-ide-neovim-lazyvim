# Config global de LazyVim (lua/config, lua/plugins, lazyvim.json) -- ver
# infra/docker/lazyvim-config/. El init.lua por-asiento (nvim-init-lazyvim.lua, copiado por
# sandbox-agent.py igual que en la imagen original) solo referencia este directorio via
# runtimepath, nunca lo duplica.
RUN mkdir -p /etc/insightbloom/nvim-lazyvim-config
COPY infra/docker/lazyvim-config/lua /etc/insightbloom/nvim-lazyvim-config/lua
COPY infra/docker/lazyvim-config/lazyvim.json /etc/insightbloom/nvim-lazyvim-config/lazyvim.json

# Precompilar los parsers de tree-sitter que LazyVim instalaria en el primer arranque (ver
# lua/plugins/insightbloom-lsp.lua: defaults de LazyVim + java/css) -- con red disponible en CI,
# para que ningun asiento necesite red/compilador en runtime (el pod puede tener
# internet_enabled=false). Esta version de nvim-treesitter (rewrite 2024+) NO instala los .so
# dentro del propio directorio del plugin -- los deja en stdpath("data").."/site/parser/" (aca,
# /opt/insightbloom/nvim-lazy/data/nvim/site/parser/), que Neovim agrega a runtimepath
# automaticamente al arrancar (confirmado con un build real: el primer intento de "test -f
# .../nvim-treesitter/parser/java.so" fallaba con "No such file or directory" pese a que el log
# mostraba "Language installed" para todos -- el directorio real es otro). Compila via "tree-sitter
# build" (el CLI real, no cc directo) -- de ahi el paquete tree-sitter-cli arriba, confirmado
# necesario con un build real que fallo con "ENOENT ... 'tree-sitter'" sin el.
RUN nvim --headless -u NONE \
    -c "set rtp+=/opt/insightbloom/nvim-lazy/data/nvim/lazy/nvim-treesitter" \
    -c "lua require('nvim-treesitter').setup()" \
    -c "lua require('nvim-treesitter').install({ 'bash','c','diff','html','javascript','jsdoc','json','lua','luadoc','luap','markdown','markdown_inline','printf','python','query','regex','toml','tsx','typescript','vim','vimdoc','xml','yaml','java','css' }):wait(600000)" \
    -c "qa" && \
    test -f /opt/insightbloom/nvim-lazy/data/nvim/site/parser/java.so && \
    test -f /opt/insightbloom/nvim-lazy/data/nvim/site/parser/python.so

RUN addgroup -g 1000 coder && \
    adduser -D -u 1000 -G coder -h /home/coder coder && \
    chown -R coder:coder /home/coder

