ENV TERM=xterm-256color

RUN mkdir -p /home/coder/workspace /home/coder/db /home/coder/.m2 /home/coder/.config/nvim
COPY --chown=coder:coder infra/docker/nvim-init-lazyvim.lua /home/coder/.config/nvim/init.lua

# Copia compartida para el seat-agent (Fase B, DEC-0025): cada asiento de un Pod multi-alumno
# copia esto a su propio "/home/{userUuid}/.config/nvim/init.lua" la primera vez que se
# aprovisiona ese alumno (sandbox-agent.py:_ensure_seat_account, SIN CAMBIOS respecto a la
# imagen original -- solo cambia el CONTENIDO de /etc/insightbloom/nvim-init.lua entre las dos
# imagenes, nunca el mecanismo de copia).
USER root
RUN mkdir -p /etc/insightbloom /usr/local/share/doc/insightbloom
COPY infra/docker/nvim-init-lazyvim.lua /etc/insightbloom/nvim-init.lua
COPY infra/docker/seed-node-types.sh /usr/local/bin/seed-node-types.sh
COPY infra/docker/sandbox-agent.py /usr/local/bin/sandbox-agent.py
COPY infra/docker/sandbox_file_api.py /usr/local/bin/sandbox_file_api.py
