# --- LazyVim: plugins vendorizados a un commit fijo (reemplaza el bloque nativo "pack/*/start"
# de la imagen original) ---
#
# SOLO XDG_DATA_HOME es global, mismo patron que NPM_CONFIG_PREFIX=/opt/insightbloom/
# node-global: todos los asientos de un Pod multi-alumno comparten LOS MISMOS plugins ya
# instalados (lazy.nvim los busca en stdpath("data").."/lazy/<nombre>", que con estas variables
# resuelve a un directorio GLOBAL fuera de /home), quedando de solo lectura para cada asiento
# (mas abajo: chown root:root + chmod a+rX). XDG_STATE_HOME/XDG_CACHE_HOME NO se comparten --
# ahi Neovim escribe swap files, shada y cache de bytecode POR ASIENTO en cada arranque, asi que
# tienen que quedar en su default (dentro de $HOME, por-usuario). Confirmado con un build real:
# fijarlos tambien al directorio global de solo lectura rompia con "E303 ... permission denied"
# al abrir cualquier archivo como el usuario coder/studentN (no-root). XDG_CONFIG_HOME tampoco se
# toca: cada asiento sigue usando su propio "~/.config/nvim/init.lua" (ver sandbox-agent.py, sin
# cambios), que solo hace rtp:prepend hacia la config real (mas abajo, /etc/insightbloom/
# nvim-lazyvim-config).
#
# nvim-treesitter: LazyVim fija un commit MAS VIEJO de la rama "main" cuando Neovim es menor a
# 0.12 (ver lazyvim/plugins/treesitter.lua: "commit = has('nvim-0.12')==0 and '7caec274...' or
# nil") -- alpine:3.23 trae neovim 0.11.7-r0 (cumple el >=0.11.2 que pide LazyVim, pero no llega
# a 0.12). El tip de main usa "vim.list.unique", una API que no existe en 0.11.7 (confirmado con
# un build real que fallo con "attempt to index field 'list' (a nil value)"); por eso se
# vendoriza el commit de compatibilidad exacto que LazyVim mismo habria elegido, no el tip.
ENV XDG_DATA_HOME=/opt/insightbloom/nvim-lazy/data
RUN mkdir -p /opt/insightbloom/nvim-lazy/data/nvim/lazy && \
    cd /opt/insightbloom/nvim-lazy/data/nvim/lazy && \
    clone_pin() { \
      git clone --quiet --branch "$2" "$1" "$3" && \
      git -C "$3" checkout --quiet "$4" && \
      rm -rf "$3/.git"; \
