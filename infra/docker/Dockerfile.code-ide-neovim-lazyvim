ENV PATH=/opt/insightbloom/node-global/bin:/home/coder/.opencode/bin:$PATH
RUN mkdir -p /opt/insightbloom/node-global && chown -R coder:coder /opt/insightbloom

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    uv \
    virtualenv \
    jupyter \
    numpy \
    pandas \
    matplotlib \
    requests \
    flask \
    django \
