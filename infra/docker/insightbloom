#!/bin/sh
set -eu
case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Uso:
  insightbloom publish [opciones]     Publica una copia temporal ESTÁTICA del sitio.
  insightbloom revoke ID              Revoca una publicación de 'publish'.
  insightbloom app-publish            Publica tu backend/API VIVO (escuchando en $APP_PORT).
  insightbloom app-revoke ID          Revoca una publicación de 'app-publish'.
  insightbloom login                  Inicia sesión y guarda el token fuera del workspace.
  insightbloom logout                 Elimina la sesión local del CLI.
  insightbloom mentor [pregunta]      Consulta el tutor IA pedagógico del evento.

Usa `insightbloom <comando> --help` para ver las opciones de cada uno.
EOF
    exit 0
    ;;
  mentor|ask)
    shift
    exec python3 /usr/local/bin/insightbloom-mentor.py mentor "$@"
    ;;
  login)
    shift
    exec python3 /usr/local/bin/insightbloom-publish.py login "$@"
    ;;
  logout)
    shift
    exec python3 /usr/local/bin/insightbloom-publish.py logout "$@"
    ;;
  *)
    exec python3 /usr/local/bin/insightbloom-publish.py "$@"
    ;;
esac
