# Imagen de toolchain para compilar los servicios Java del backend (IBM Semeru JDK + Maven).
# No trae código fuente -- es una base reusable que `container/backend/java/Dockerfile` usa como
# `FROM ... AS builder`. Se publica aparte (ver .github/workflows/publish-java-base-images.yml)
# para que el JDK y Maven no se vuelvan a descargar en cada uno de los 7 builds de servicio.
#
# IBM Semeru (OpenJ9) no publica imagen oficial para Debian-slim ni Alpine, solo Ubuntu -- de ahí
# que esta imagen se arme a mano sobre debian-slim descargando el tarball oficial de
# github.com/ibmruntimes/semeru25-binaries y verificando su checksum.
FROM debian:bookworm-slim

ARG SEMERU_VERSION=25.0.4.0
ARG SEMERU_TARBALL=ibm-semeru-open-jdk_x64_linux_25.0.4.0.tar.gz
ARG SEMERU_SHA256=780a44566a626d3961aaf93a1c81b2d6265029c1350a467eb5e9a3b1cafe68bd
ARG MAVEN_VERSION=3.9.9
ARG MAVEN_SHA512=a555254d6b53d267965a3404ecb14e53c3827c09c3b94b5678835887ab404556bfaf78dcfe03ba76fa2508649dca8531c74bca4d5846513522404d48e8c4ac8b

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# JDK Semeru
RUN curl -fsSL -o /tmp/semeru.tar.gz \
      "https://github.com/ibmruntimes/semeru25-binaries/releases/download/jdk-${SEMERU_VERSION}/${SEMERU_TARBALL}" \
    && echo "${SEMERU_SHA256}  /tmp/semeru.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/java \
    && tar xzf /tmp/semeru.tar.gz -C /opt/java --strip-components=1 \
    && rm -f /tmp/semeru.tar.gz

# Maven (mismo tarball/versión que se usaba antes vía apk+wget)
RUN curl -fsSL -o /tmp/maven.tar.gz \
      "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
    && echo "${MAVEN_SHA512}  /tmp/maven.tar.gz" | sha512sum -c - \
    && mkdir -p /opt/maven \
    && tar xzf /tmp/maven.tar.gz -C /opt/maven --strip-components=1 \
    && rm -f /tmp/maven.tar.gz

ENV JAVA_HOME=/opt/java
ENV MAVEN_HOME=/opt/maven
ENV PATH="${JAVA_HOME}/bin:${MAVEN_HOME}/bin:${PATH}"

RUN java -version && mvn -version
