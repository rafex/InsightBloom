# TASK-0011: Variante Web (HTML/JS/CSS)
# Extiende base code-ide con Node.js/npm completo + herramientas web

FROM ghcr.io/rafex/insightbloom-code-ide:base

# No se necesita 'apk' en esta variante, así que no hace falta volver a root en ningún
# momento: todo corre como 'coder' (heredado de la base), usando el prefix npm de
# usuario ya configurado ahí — mismo hardening que code-server en la imagen base.

# Node.js y npm ya están en la base, pero se actualiza a versión latest
RUN npm install -g npm@latest

# Instalar herramientas web comunes: TypeScript, build tools, linters, formatters
RUN npm install -g \
    typescript \
    ts-node \
    @vue/cli \
    create-react-app \
    create-vite \
    esbuild \
    webpack \
    webpack-cli \
    prettier \
    eslint \
    @typescript-eslint/parser \
    @typescript-eslint/eslint-plugin

# Instalar extensiones web para code-server
RUN code-server --install-extension esbenp.prettier-vscode \
    --install-extension dbaeumer.vscode-eslint \
    --install-extension vue.volar \
    --install-extension dsznajder.es7-react-js-snippets \
    --install-extension bradlc.vscode-tailwindcss \
    --install-extension ecmel.vscode-html-css

# Workspace y db directorios (heredados de base)
EXPOSE 8080

ENTRYPOINT ["dumb-init", "--"]
CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "/home/coder/workspace", "--disable-auth"]
