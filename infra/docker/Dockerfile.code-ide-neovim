# Imagen "neovim" del IDE (cambio de paradigma 2026-07-17): vim/neovim + lazygit 100%
# autocontenidos, servidos por ttyd (terminal web) -- sin contenedor "ide" (code-server) ni
# bridge via socat. Reemplaza a Dockerfile.code-ide-runtime (que hasta ahora cumplia doble
# funcion: bridge de terminal integrada de code-server Y modo alternativo "terminal-nvim").
# Ahora cada imagen es un modo de IDE completo e independiente -- esta es la opcion liviana
# 100% terminal para quien no necesita el editor grafico de code-server.
FROM alpine:3.21

ARG RUNTIME_GIT_SHA=unknown
ARG RUNTIME_BUILD_DATE=unknown
RUN printf 'git sha: %s\nbuild:   %s\n' "$RUNTIME_GIT_SHA" "$RUNTIME_BUILD_DATE" \
    > /etc/insightbloom-runtime-version
RUN echo "alpine / vim-neovim" > /etc/insightbloom-image-name

# Paquetes base + editor (vim/neovim/lazygit, pedido explicito) + "herramientas para dar
# cursos" (bat/fd/ripgrep/eza/ncdu mejoran cat/find/grep/ls/du; jq para JSON; tmux+tree
# utilitarios de terminal; httpie para probar APIs; shellcheck para feedback de bash;
# build-base para ejemplos nativos y compilar modulos nativos de npm; mandoc+less para "man"
# y paginado; musl-locales intenta dar soporte de es_ES, con soporte parcial -- musl no tiene
# locales reales como glibc, ver nota mas abajo sobre LANG).
#
# eza/lazygit/bat/fd/ripgrep se toman de apk (no del tarball de GitHub como en la imagen
# Debian): Alpine SI los publica, a diferencia del apt de Debian bookworm. Se acepta que la
# version exacta de estas herramientas de conveniencia varie levemente entre las dos imagenes
# (misma logica que ya se acepta para bat/fd/ripgrep en Debian) -- lo que el usuario pidio con
# version EXACTA es Java/Python/Node, no estas.
RUN apk add --no-cache \
    bash \
    bash-completion \
    dumb-init \
    git \
    sqlite \
    curl \
    iputils \
    ca-certificates \
    unzip \
    less \
    nano \
    mandoc \
    musl-locales \
    fzf \
    jq \
    tmux \
    xclip \
    tree \
    bat \
    eza \
    fd \
    ripgrep \
    httpie \
    shellcheck \
    ncdu \
    build-base \
    maven \
    neovim \
    vim \
    jdtls \
    lazygit \
    ttyd \
    tree-sitter-java \
    tree-sitter-python \
    tree-sitter-javascript \
    tree-sitter-typescript \
    tree-sitter-json \
    tree-sitter-html \
    tree-sitter-css \
    tree-sitter-bash

# musl no implementa locales reales (a diferencia de glibc): esto NO da mensajes de sistema
# en espanol, solo asegura que UTF-8 (acentos/enies) se muestre bien en terminal -- el idioma
# de la UI en espanol vive en la imagen Debian (code-server --locale es). Para esta imagen
# 100%-terminal el publico interactua con nvim/bash directamente, sin una capa de UI que traducir.
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Java 25 LTS Temurin jdk-25.0.3+9 -- mismos URL/SHA256 pedidos por el usuario que en la imagen
# Debian, pero el build "alpine-linux" (musl) en vez de "linux" (glibc): Temurin publica un
# tarball especifico para Alpine porque un JDK glibc no corre sobre musl sin capa de
# compatibilidad. Version y hash verificados en forma independiente antes de bakearlos aca.
ARG TEMURIN_JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.3%2B9/OpenJDK25U-jdk_x64_alpine-linux_hotspot_25.0.3_9.tar.gz
ARG TEMURIN_JDK_SHA256=51c2415b370aac7c3796b0c4663c8fcf91bc22d76f03df95b25fa5667cb5fdd8
RUN curl -fsSL "$TEMURIN_JDK_URL" -o /tmp/temurin.tar.gz && \
    echo "${TEMURIN_JDK_SHA256}  /tmp/temurin.tar.gz" | sha256sum -c - && \
    mkdir -p /usr/local/lib/jvm/temurin-25 && \
    tar -xzf /tmp/temurin.tar.gz -C /usr/local/lib/jvm/temurin-25 --strip-components=1 && \
    rm /tmp/temurin.tar.gz
ENV JAVA_HOME=/usr/local/lib/jvm/temurin-25
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Python 3.12.13 -- mismo build de python-build-standalone que la imagen Debian, variante musl
# (Alpine no puede correr el build glibc). Mismo patch exacto (3.12.13) en las dos imagenes.
ARG PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260623/cpython-3.12.13%2B20260623-x86_64-unknown-linux-musl-install_only.tar.gz
ARG PYTHON_SHA256=1bd4bba28b410dc617dd4a386ce08bc988b87c4320d1532682f488cc5e16edc7
RUN curl -fsSL "$PYTHON_URL" -o /tmp/python.tar.gz && \
    echo "${PYTHON_SHA256}  /tmp/python.tar.gz" | sha256sum -c - && \
    mkdir -p /usr/local/lib/python-3.12 && \
    tar -xzf /tmp/python.tar.gz -C /usr/local/lib/python-3.12 --strip-components=1 && \
    rm /tmp/python.tar.gz && \
    ln -s /usr/local/lib/python-3.12/bin/python3 /usr/local/bin/python3 && \
    ln -s /usr/local/lib/python-3.12/bin/python3 /usr/local/bin/python && \
    ln -s /usr/local/lib/python-3.12/bin/pip3 /usr/local/bin/pip3 && \
    ln -s /usr/local/lib/python-3.12/bin/pip3 /usr/local/bin/pip
# Solo python3/pip quedan symlinkeados arriba -- cualquier OTRO script que "pip install" agregue
# despues (uv, virtualenv, jupyter, black, pylint, etc.) queda instalado en
# /usr/local/lib/python-3.12/bin/ sin quedar expuesto como comando bare. Se agrega ese directorio
# al PATH para que todos esos scripts (no solo python3/pip) se puedan invocar directo. Bug real
# encontrado en CI: "uv tool install" (mas abajo) fallaba con "uv: not found" por esto mismo.
ENV PATH="/usr/local/lib/python-3.12/bin:${PATH}"

# Node.js LTS 24.18.0 -- nodejs.org NO publica builds musl oficiales (solo glibc); se usa el
# build de unofficial-builds.nodejs.org (proyecto de la comunidad Node, referenciado desde la
# propia documentacion de nodejs.org para plataformas no cubiertas por los builds oficiales,
# entre ellas musl/Alpine) para llegar a la MISMA version exacta 24.18.0 que la imagen Debian,
# en vez de resignarse a la version mas vieja que trae el apk de Alpine (22.x/23.x).
ARG NODE_URL=https://unofficial-builds.nodejs.org/download/release/v24.18.0/node-v24.18.0-linux-x64-musl.tar.gz
ARG NODE_SHA256=ea58409911e141ec6b19d9178efa2d9185a13295005b1cbf5521b3157eed1d95
RUN curl -fsSL "$NODE_URL" -o /tmp/node.tar.gz && \
    echo "${NODE_SHA256}  /tmp/node.tar.gz" | sha256sum -c - && \
    mkdir -p /usr/local/lib/node-24 && \
    tar -xzf /tmp/node.tar.gz -C /usr/local/lib/node-24 --strip-components=1 && \
    rm /tmp/node.tar.gz
ENV PATH="/usr/local/lib/node-24/bin:${PATH}"

# gobang -- TUI para navegar tablas/schema de SQLite (persistencia de la plataforma es siempre
# SQLite), mismo espiritu que lazygit. No esta en los repos de Alpine, se instala igual que
# Java/Python/Node arriba: binario fijado por version + SHA256 verificado, en vez de un tarball
# "latest" sin checksum.
ARG GOBANG_URL=https://github.com/TaKO8Ki/gobang/releases/download/v0.1.0-alpha.5/gobang-0.1.0-alpha.5-x86_64-unknown-linux-musl.tar.gz
ARG GOBANG_SHA256=29b8f517937cf19691c6e594a0789fe80a528fff05c346883af0e2950b9b90ef
RUN curl -fsSL "$GOBANG_URL" -o /tmp/gobang.tar.gz && \
    echo "${GOBANG_SHA256}  /tmp/gobang.tar.gz" | sha256sum -c - && \
    mkdir -p /tmp/gobang-extract && \
    tar -xzf /tmp/gobang.tar.gz -C /tmp/gobang-extract --strip-components=1 && \
    install -m 0755 /tmp/gobang-extract/gobang /usr/local/bin/gobang && \
    rm -rf /tmp/gobang.tar.gz /tmp/gobang-extract

# bash-completion no se auto-carga en shells de login en Alpine (a diferencia de Debian); el
# paquete solo instala el script, sin engancharlo a /etc/profile.d.
RUN echo '. /usr/share/bash-completion/bash_completion' > /etc/profile.d/bash_completion.sh

# just + tmux plugins are vendored in the image, so the IDE remains usable when
# the sandbox has no outbound network access.
COPY infra/docker/install-just.sh /usr/local/bin/install-just.sh
COPY infra/docker/install-tmux-plugins.sh /usr/local/bin/install-tmux-plugins.sh
RUN chmod +x /usr/local/bin/install-just.sh /usr/local/bin/install-tmux-plugins.sh && \
    /usr/local/bin/install-just.sh && \
    /usr/local/bin/install-tmux-plugins.sh && \
    rm -f /usr/local/bin/install-just.sh /usr/local/bin/install-tmux-plugins.sh

COPY infra/docker/runtime-prompt.sh /etc/profile.d/insightbloom-prompt.sh
COPY infra/docker/runtime-banner.sh /etc/profile.d/insightbloom-banner.sh
COPY infra/docker/runtime-path.sh /etc/profile.d/000-insightbloom-path.sh
COPY infra/docker/runtime-debug-helpers.sh /etc/profile.d/insightbloom-debug-helpers.sh
COPY infra/docker/runtime-fzf.sh /etc/profile.d/insightbloom-fzf.sh
COPY infra/docker/runtime-insightbloom-completion.sh /etc/profile.d/insightbloom-completion.sh

# Plugins de Neovim vendorizados en build time (git clone, con red disponible en CI) e
# instalados como paquetes nativos de Neovim (pack/*/start/, auto-cargados sin plugin manager)
# -- el pod en runtime puede tener internet_enabled=false, asi que nada de esto puede depender
# de red ni de Lazy/Packer descargando al arrancar.
RUN mkdir -p /usr/share/nvim/site/pack/plugins/start && \
    cd /usr/share/nvim/site/pack/plugins/start && \
    for repo in \
      "https://github.com/nvim-tree/nvim-tree.lua" \
      "https://github.com/hrsh7th/nvim-cmp" \
      "https://github.com/hrsh7th/cmp-nvim-lsp" \
      "https://github.com/L3MON4D3/LuaSnip" \
      "https://github.com/neovim/nvim-lspconfig" \
      "https://github.com/mfussenegger/nvim-jdtls" \
    ; do \
      if [ "$repo" = "https://github.com/neovim/nvim-lspconfig" ]; then \
        git clone --depth 1 --branch v2.3.0 --single-branch "$repo" "$(basename "$repo")"; \
      else \
        git clone --depth 1 "$repo" "$(basename "$repo")"; \
      fi; \
    done && \
    find /usr/share/nvim/site/pack/plugins/start -name .git -type d -prune -exec rm -rf {} \;

RUN addgroup -g 1000 coder && \
    adduser -D -u 1000 -G coder -h /home/coder coder && \
    chown -R coder:coder /home/coder

# El modo CLI multi-asiento monta el emptyDir del workspace en /home completo. Los binarios
# instalados bajo /home/coder quedarían ocultos por ese volumen y Neovim perdería los LSP al
# aprovisionar un asiento. Mantener el prefijo global fuera de /home hace que la instalación
# siga siendo visible para coder, studentN y el agente aunque cada asiento tenga su propio home.
ENV NPM_CONFIG_PREFIX=/opt/insightbloom/node-global
ENV PATH=/opt/insightbloom/node-global/bin:/home/coder/.opencode/bin:$PATH
RUN mkdir -p /opt/insightbloom/node-global && chown -R coder:coder /opt/insightbloom

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    uv \
    virtualenv \
    jupyter \
    numpy \
    pandas \
    matplotlib \
    requests \
    flask \
    django \
    fastapi \
    pytest \
    black \
    pylint \
    debugpy

# Posting (https://posting.sh/) es el cliente REST de terminal para el IDE CLI. Se instala
# mediante uv en un entorno aislado fuera de /home: el home/workspace se monta como emptyDir
# por asiento y no debe ocultar herramientas precargadas de la imagen. El binario queda global
# para coder, studentN y el agente, y las peticiones siguen sujetas a la NetworkPolicy/proxy
# de egress del sandbox.
ENV UV_TOOL_DIR=/opt/insightbloom/uv-tools
ENV UV_TOOL_BIN_DIR=/usr/local/bin
RUN mkdir -p "$UV_TOOL_DIR" && \
    UV_CACHE_DIR=/tmp/insightbloom-uv-cache uv tool install --python /usr/local/bin/python3 'posting==2.10.0' && \
    rm -rf /tmp/insightbloom-uv-cache && \
    test -x /usr/local/bin/posting

USER coder
WORKDIR /home/coder

RUN npm install -g npm@latest && \
    npm install -g \
    typescript \
    ts-node \
    @vue/cli \
    create-react-app \
    create-vite \
    esbuild \
    webpack \
    webpack-cli \
    prettier \
    eslint \
    typescript-language-server@5.3.0 \
    pyright@1.1.411 \
    vscode-langservers-extracted@4.10.0 \
    @typescript-eslint/parser \
    @typescript-eslint/eslint-plugin

# opencode (CLI de agente de codigo IA, https://opencode.ai, de SST) -- costo fijo aceptado
# incondicionalmente (auditoria de seguridad 2026-07-17), igual que en la imagen Debian.
RUN curl -fsSL https://opencode.ai/install | bash

# opentui (libreria de TUI de opencode) vs Ghostty CSI ?997n -- mismo bug/mitigacion que la
# imagen Debian, ver comentario alla.
ENV TERM=xterm-256color

RUN mkdir -p /home/coder/workspace /home/coder/db /home/coder/.m2 /home/coder/.config/nvim
COPY --chown=coder:coder Makefile /home/coder/Makefile
COPY --chown=coder:coder Justfile /home/coder/Justfile
COPY --chown=coder:coder infra/docker/nvim-init.lua /home/coder/.config/nvim/init.lua

# Copia compartida de nvim-init.lua para el seat-agent (Fase B, DEC-0025): cada asiento de un
# Pod multi-alumno copia esto a su propio "/home/{userUuid}/.config/nvim/init.lua" la primera
# vez que se aprovisiona ese alumno (ver sandbox-agent.py:_ensure_seat_account) -- una sola
# fuente de verdad para la config de nvim, sea Pod de 1 asiento o compartido. USER root: el
# resto del Dockerfile corre como "coder" (no-root) desde arriba, pero /etc/insightbloom y
# /usr/local/bin no son escribibles por ese usuario.
USER root
RUN mkdir -p /etc/insightbloom /usr/local/share/doc/insightbloom /usr/local/share/insightbloom
COPY infra/docker/nvim-init.lua /etc/insightbloom/nvim-init.lua
COPY infra/docker/insightbloom-bash-completion.sh /usr/share/bash-completion/completions/insightbloom
COPY infra/docker/insightbloom-tmux-clipboard /usr/local/bin/insightbloom-tmux-clipboard
COPY infra/docker/tmux.conf /etc/tmux.conf
COPY Makefile Justfile /usr/local/share/insightbloom/
COPY infra/docker/seed-node-types.sh /usr/local/bin/seed-node-types.sh
COPY infra/docker/sandbox-agent.py /usr/local/bin/sandbox-agent.py
COPY infra/docker/sandbox_file_api.py /usr/local/bin/sandbox_file_api.py
COPY infra/docker/insightbloom-publish.py /usr/local/bin/insightbloom-publish.py
COPY infra/docker/insightbloom-mentor.py /usr/local/bin/insightbloom-mentor.py
COPY infra/docker/insightbloom /usr/local/bin/insightbloom
COPY infra/docker/IDE-WEB-PUBLICATION.md /usr/local/share/doc/insightbloom/IDE-WEB-PUBLICATION.md
COPY infra/docker/IDE-AI-MENTOR.md /usr/local/share/doc/insightbloom/IDE-AI-MENTOR.md
COPY infra/docker/IDE-REST-CLIENT.md /usr/local/share/doc/insightbloom/IDE-REST-CLIENT.md
COPY infra/docker/IDE-APP-PUBLICATION.md /usr/local/share/doc/insightbloom/IDE-APP-PUBLICATION.md
COPY infra/docker/seed-ide-docs.sh /usr/local/bin/seed-ide-docs.sh
COPY infra/docker/seed-remote-git.sh /usr/local/bin/seed-remote-git.sh
RUN mkdir -p /usr/local/share/insightbloom-node-types && \
    npm install --prefix /usr/local/share/insightbloom-node-types --omit=dev @types/node && \
    chmod -R a+rX /usr/local/share/insightbloom-node-types && \
    test -x /opt/insightbloom/node-global/bin/typescript-language-server && \
    test -x /opt/insightbloom/node-global/bin/pyright-langserver && \
    test -x /opt/insightbloom/node-global/bin/vscode-html-language-server && \
    test -x /opt/insightbloom/node-global/bin/vscode-css-language-server && \
    chmod +x /usr/local/bin/seed-node-types.sh /usr/local/bin/sandbox-agent.py \
    /usr/local/bin/insightbloom-publish.py /usr/local/bin/insightbloom-mentor.py /usr/local/bin/insightbloom \
    /usr/local/bin/seed-ide-docs.sh /usr/local/bin/seed-remote-git.sh \
    /usr/local/bin/insightbloom-tmux-clipboard

# La consulta distribuida por Alpine usa #is-not?, un predicado de nvim-treesitter que no
# existe en Neovim 0.10.4. Se conserva el resaltado JavaScript con una variante compatible
# para evitar que el highlighter falle al encontrar scripts embebidos en HTML.
RUN mkdir -p /etc/insightbloom/queries/javascript && \
    test -f /usr/share/tree-sitter/queries/javascript/highlights.scm && \
    sed '/#is-not? local/d' /usr/share/tree-sitter/queries/javascript/highlights.scm \
      > /etc/insightbloom/queries/javascript/highlights.scm
USER coder

# Puerto ttyd: 8080, mismo puerto publico que usa la imagen Debian (code-server) -- cada
# sandbox corre UNA sola imagen ahora, nunca las dos a la vez, asi que no hay conflicto.
# Rango 8071-8089: puerto de control del seat-agent (8079, ver KubernetesPodClient.controlPort)
# + hasta 10 asientos (8080-8089, ver MAX_SEATS_PER_POD) -- solo se usan realmente en Pods
# multi-alumno; EXPOSE es documentacion, no reserva nada en runtime.
EXPOSE 8079-8089

ENTRYPOINT ["dumb-init", "--"]
# Precreamos la sesion tmux DESTACADA (-d) en su propio proceso, ANTES de arrancar ttyd, y ttyd
# solo hace "attach-session" -- si dejamos que ttyd arranque tmux directamente (ej. "ttyd ...
# tmux new-session -A"), el server de tmux nace todavia compartiendo el process group del pty que
# ttyd controla, y el SIGHUP que ttyd manda al cerrar el WebSocket (--close-signal) alcanza
# tambien al server recien creado antes de que termine de independizarse -- confirmado en vivo: la
# sesion desaparecia por completo ("tmux ls" -> "no server running") apenas se cortaba la
# conexion, perdiendo todo el estado del editor igual que sin tmux (ver incidente 2026-07-19).
# Precrear la sesion en un proceso que ya termino (sin pty de ttyd de por medio) resuelve la
# carrera de raiz: cualquier reconexion reatende la MISMA sesion en vez de perder el estado.
CMD ["sh", "-c", "/usr/local/bin/seed-remote-git.sh /home/coder/workspace; /usr/local/bin/seed-node-types.sh /home/coder/workspace; /usr/local/bin/seed-ide-docs.sh /home/coder/workspace; tmux new-session -d -s main -c /home/coder/workspace nvim . ; exec ttyd -p 8080 -W --ping-interval 15 tmux attach-session -t main"]
