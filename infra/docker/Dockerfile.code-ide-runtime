# Fase 4 del IDE: contenedor "runtime" — toolchain unico (Java+Node+Python), sin code-server.
# Corre en el mismo Pod que Dockerfile.code-ide-server; expone un shell vía socat en
# 127.0.0.1:7681 (loopback intra-Pod) al que la terminal integrada de code-server se conecta.
#
# Reemplaza las 3 imagenes por-variante (java/python/web) que existian antes (2026-07-12 a
# 2026-07-17): un mismo taller/sandbox puede necesitar mas de un lenguaje a la vez (ej. un
# workspace con .java y .py juntos), y mantener 3 imagenes exclusivas obligaba a re-crear la
# sandbox si el alumno tocaba un archivo del lenguaje "equivocado". El costo es una imagen mas
# pesada (~1-2GB extra) y algo mas de superficie instalada; se acepta porque el runtime nunca
# ejecuta codigo no confiable sin que el alumno ya tenga acceso completo a esa misma shell.
#
# 2026-07-17 (segunda ronda): tambien trae Neovim configurado como IDE completo (LSP de Java via
# jdtls, arbol de archivos, autocompletado, syntax highlighting via tree-sitter) + herramientas
# de terminal modernas (tmux, fzf, bat, eza, fd, ripgrep, lazygit). Sirve para dos casos de uso:
# (a) la terminal integrada de code-server (conexion via socat, sin cambios), donde el alumno
# puede simplemente correr "nvim"; (b) un modo de IDE alternativo mas liviano basado 100% en
# terminal, servido por ttyd, para conferencias que eligen "ideMode=terminal-nvim" (ver
# KubernetesPodClient.java) en vez de levantar el contenedor code-server completo.
FROM alpine:3.21

# Version del build, para debug rapido desde la terminal (ver runtime-banner.sh): que pod esta
# corriendo que commit, sin tener que consultar kubectl desde afuera. Inyectado por CI
# (.github/workflows/publish-code-ide.yml); "unknown" en builds locales sin --build-arg.
ARG RUNTIME_GIT_SHA=unknown
ARG RUNTIME_BUILD_DATE=unknown
RUN printf 'git sha: %s\nbuild:   %s\n' "$RUNTIME_GIT_SHA" "$RUNTIME_BUILD_DATE" \
    > /etc/insightbloom-runtime-version

RUN apk add --no-cache \
    bash \
    bash-completion \
    socat \
    dumb-init \
    git \
    sqlite \
    curl \
    ca-certificates \
    openjdk21 \
    maven \
    nodejs \
    npm \
    python3 \
    python3-dev \
    py3-pip \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev \
    neovim \
    jdtls \
    tmux \
    fzf \
    bat \
    eza \
    fd \
    ripgrep \
    lazygit \
    ttyd \
    tree-sitter-java \
    tree-sitter-python \
    tree-sitter-javascript \
    tree-sitter-typescript \
    tree-sitter-json \
    tree-sitter-html \
    tree-sitter-css \
    tree-sitter-bash

# bash-completion no se auto-carga en shells de login en Alpine (a diferencia de Debian/Ubuntu);
# el paquete solo instala /usr/share/bash-completion/bash_completion, sin engancharlo a
# /etc/profile.d. La shell de la terminal integrada es login ("/bin/bash -l", ver CMD abajo),
# asi que hay que abastecerlo explicitamente ahi.
RUN echo '. /usr/share/bash-completion/bash_completion' > /etc/profile.d/bash_completion.sh

# Prompt coloreado con rama de git + banner de bienvenida con versiones (Java/Node/Python/build) --
# mismo mecanismo /etc/profile.d que bash-completion arriba (necesario porque la shell de la
# terminal integrada es login, no lee ~/.bashrc). Ver contenido de cada script para el porque.
COPY infra/docker/runtime-prompt.sh /etc/profile.d/insightbloom-prompt.sh
COPY infra/docker/runtime-banner.sh /etc/profile.d/insightbloom-banner.sh

# javadebug/pydebug: wrappers para debug remoto (JDWP/debugpy) desde el editor -- ver el archivo
# para el porque de este approach en vez de instalar Java/Python en el contenedor "ide".
COPY infra/docker/runtime-debug-helpers.sh /etc/profile.d/insightbloom-debug-helpers.sh

# Plugins de Neovim vendorizados en build time (git clone, con red disponible en CI) e instalados
# como paquetes nativos de Neovim (carpeta pack/*/start/ = auto-cargados al iniciar, sin plugin
# manager) -- el pod en runtime puede tener internet_enabled=false (DEC-0023), asi que nada de
# esto puede depender de red ni de un plugin manager (Lazy/Packer) que descargue al arrancar.
RUN mkdir -p /usr/share/nvim/site/pack/plugins/start && \
    cd /usr/share/nvim/site/pack/plugins/start && \
    for repo in \
      "https://github.com/nvim-tree/nvim-tree.lua" \
      "https://github.com/hrsh7th/nvim-cmp" \
      "https://github.com/hrsh7th/cmp-nvim-lsp" \
      "https://github.com/L3MON4D3/LuaSnip" \
      "https://github.com/mfussenegger/nvim-jdtls" \
    ; do \
      git clone --depth 1 "$repo" "$(basename "$repo")"; \
    done && \
    find /usr/share/nvim/site/pack/plugins/start -name .git -type d -prune -exec rm -rf {} \;

# Mismo uid/gid 1000 que el contenedor 'ide' (Dockerfile.code-ide-server): el volumen
# 'workspace' se comparte entre ambos contenedores del Pod, necesitan el mismo dueño.
RUN addgroup -g 1000 coder && \
    adduser -D -u 1000 -G coder -h /home/coder coder && \
    chown -R coder:coder /home/coder

# Prefix npm global escribible por 'coder', para instalar el toolchain web sin root
ENV NPM_CONFIG_PREFIX=/home/coder/.npm-global
ENV PATH=/home/coder/.npm-global/bin:$PATH
RUN mkdir -p /home/coder/.npm-global && chown coder:coder /home/coder/.npm-global

RUN pip install --no-cache-dir --upgrade pip --break-system-packages && \
    pip install --no-cache-dir --break-system-packages \
    virtualenv \
    jupyter \
    numpy \
    pandas \
    requests \
    flask \
    django \
    pytest \
    black \
    pylint \
    debugpy

USER coder
WORKDIR /home/coder

RUN npm install -g npm@latest

RUN npm install -g \
    typescript \
    ts-node \
    @vue/cli \
    create-react-app \
    create-vite \
    esbuild \
    webpack \
    webpack-cli \
    prettier \
    eslint \
    @typescript-eslint/parser \
    @typescript-eslint/eslint-plugin

RUN python3 -m venv /home/coder/.venv

# opencode (CLI de agente de codigo IA, https://opencode.ai, de SST): se instala en runtime (no
# en ide) porque la terminal integrada de code-server conecta aca via socat, y es donde el
# alumno lo va a correr. El instalador intenta modificar ~/.bashrc para agregar su bin al PATH,
# pero la shell de la terminal es login y Alpine no lee ~/.bashrc para logins (ver runtime-
# prompt.sh) -- se agrega el PATH explicitamente aca en vez de confiar en esa modificacion.
RUN curl -fsSL https://opencode.ai/install | bash
ENV PATH=/home/coder/.opencode/bin:$PATH

RUN mkdir -p /home/coder/workspace /home/coder/db /home/coder/.m2 /home/coder/.config/nvim
COPY --chown=coder:coder infra/docker/nvim-init.lua /home/coder/.config/nvim/init.lua

# Puerto socat: solo accesible por loopback intra-Pod (bind=127.0.0.1 en el CMD) — nunca se
# expone vía Service ni Ingress, no requiere NetworkPolicy adicional. Puerto ttyd: 8080, mismo
# puerto que usa el contenedor 'ide' para code-server -- el Service del Pod solo enruta a UNO de
# los dos contenedores segun 'ideMode' (ver KubernetesPodClient.java), nunca a ambos a la vez.
EXPOSE 7681 8080

ENTRYPOINT ["dumb-init", "--"]
# Comando por defecto: socat (modo code-server, terminal integrada). El modo alternativo
# "ideMode=terminal-nvim" pisa este comando en el pod spec para correr ttyd + nvim en su lugar
# (ver KubernetesPodClient.java) -- misma imagen, distinto comando segun el contenedor que
# efectivamente exponga el Service del Pod.
CMD ["socat", "TCP-LISTEN:7681,reuseaddr,fork,bind=127.0.0.1", "EXEC:/bin/bash -l,pty,stderr,setsid,sigint,sane"]
