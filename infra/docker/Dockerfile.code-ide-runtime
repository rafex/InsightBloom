# Fase 4 del IDE: contenedor "runtime" — toolchain unico (Java+Node+Python), sin code-server.
# Corre en el mismo Pod que Dockerfile.code-ide-server; expone un shell vía socat en
# 127.0.0.1:7681 (loopback intra-Pod) al que la terminal integrada de code-server se conecta.
#
# Reemplaza las 3 imagenes por-variante (java/python/web) que existian antes (2026-07-12 a
# 2026-07-17): un mismo taller/sandbox puede necesitar mas de un lenguaje a la vez (ej. un
# workspace con .java y .py juntos), y mantener 3 imagenes exclusivas obligaba a re-crear la
# sandbox si el alumno tocaba un archivo del lenguaje "equivocado". El costo es una imagen mas
# pesada (~1-2GB extra) y algo mas de superficie instalada; se acepta porque el runtime nunca
# ejecuta codigo no confiable sin que el alumno ya tenga acceso completo a esa misma shell.
FROM alpine:3.21

RUN apk add --no-cache \
    bash \
    bash-completion \
    socat \
    dumb-init \
    git \
    sqlite \
    curl \
    ca-certificates \
    openjdk21 \
    maven \
    nodejs \
    npm \
    python3 \
    python3-dev \
    py3-pip \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev

# bash-completion no se auto-carga en shells de login en Alpine (a diferencia de Debian/Ubuntu);
# el paquete solo instala /usr/share/bash-completion/bash_completion, sin engancharlo a
# /etc/profile.d. La shell de la terminal integrada es login ("/bin/bash -l", ver CMD abajo),
# asi que hay que abastecerlo explicitamente ahi.
RUN echo '. /usr/share/bash-completion/bash_completion' > /etc/profile.d/bash_completion.sh

# Mismo uid/gid 1000 que el contenedor 'ide' (Dockerfile.code-ide-server): el volumen
# 'workspace' se comparte entre ambos contenedores del Pod, necesitan el mismo dueño.
RUN addgroup -g 1000 coder && \
    adduser -D -u 1000 -G coder -h /home/coder coder && \
    chown -R coder:coder /home/coder

# Prefix npm global escribible por 'coder', para instalar el toolchain web sin root
ENV NPM_CONFIG_PREFIX=/home/coder/.npm-global
ENV PATH=/home/coder/.npm-global/bin:$PATH
RUN mkdir -p /home/coder/.npm-global && chown coder:coder /home/coder/.npm-global

RUN pip install --no-cache-dir --upgrade pip --break-system-packages && \
    pip install --no-cache-dir --break-system-packages \
    virtualenv \
    jupyter \
    numpy \
    pandas \
    requests \
    flask \
    django \
    pytest \
    black \
    pylint

USER coder
WORKDIR /home/coder

RUN npm install -g npm@latest

RUN npm install -g \
    typescript \
    ts-node \
    @vue/cli \
    create-react-app \
    create-vite \
    esbuild \
    webpack \
    webpack-cli \
    prettier \
    eslint \
    @typescript-eslint/parser \
    @typescript-eslint/eslint-plugin

RUN python3 -m venv /home/coder/.venv

RUN mkdir -p /home/coder/workspace /home/coder/db /home/coder/.m2

# Puerto solo accesible por loopback intra-Pod (bind=127.0.0.1 en el CMD) — nunca se expone
# vía Service ni Ingress, no requiere NetworkPolicy adicional
EXPOSE 7681

ENTRYPOINT ["dumb-init", "--"]
# Forma exec-array: cada elemento se pasa literal a execve, sin shell intermedio. Patrón
# estándar de socat para "shell sobre TCP" (fork = una sesión por conexión, pty = terminal real).
CMD ["socat", "TCP-LISTEN:7681,reuseaddr,fork,bind=127.0.0.1", "EXEC:/bin/bash -l,pty,stderr,setsid,sigint,sane"]
