# TASK-0011: Variante Python
# Extiende base code-ide con Python 3, pip, y dependencias comunes

FROM ghcr.io/rafex/insightbloom-code-ide:base

USER root

# Instalar Python 3 completo + pip (ya está en base alpine, pero asegurar)
RUN apk add --no-cache \
    python3-dev \
    py3-pip \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev

# Upgrade pip y instalar dependencias comunes de desarrollo Python
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    virtualenv \
    jupyter \
    numpy \
    pandas \
    requests \
    flask \
    django \
    pytest \
    black \
    pylint

# Instalar extensión Python para code-server
RUN code-server --install-extension ms-python.python \
    --install-extension ms-python.vscode-pylance \
    --install-extension ms-python.debugpy

USER coder

# Crear ambiente virtual default
RUN python3 -m venv /home/coder/.venv

# Workspace y db directorios (heredados de base)
EXPOSE 8080

ENTRYPOINT ["dumb-init", "--"]
CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "/home/coder/workspace", "--disable-auth"]
