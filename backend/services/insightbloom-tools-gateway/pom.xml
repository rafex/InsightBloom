<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.rafex.insightbloom</groupId>
    <artifactId>insightbloom-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>insightbloom-tools-gateway</artifactId>
  <name>InsightBloom Tools Gateway</name>

  <!--
    Proxy autenticador delante de drawio/Excalidraw/Etherpad (y a futuro Jitsi self-hosted):
    valida sesion de InsightBloom antes de reenviar cualquier request al pod real de la
    herramienta, para que pegar la URL publica directamente (bypaseando el frontend) ya no
    de acceso a nadie sin sesion. Usa solo el Handler de bajo nivel de Jetty 12 (ya cacheado
    transitivamente via ether-http-jetty12) + java.net.http.HttpClient del JDK para el
    reenvio — sin jetty-proxy/jetty-servlet (versiones no compatibles con Jetty 12 core
    disponibles en este entorno).
  -->
  <dependencies>
    <dependency>
      <groupId>dev.rafex.ether.http</groupId>
      <artifactId>ether-http-jetty12</artifactId>
    </dependency>
    <!-- TASK-0020: proxy de WebSocket (Etherpad socket.io, code-server) -->
    <dependency>
      <groupId>dev.rafex.ether.websocket</groupId>
      <artifactId>ether-websocket-proxy-jetty12</artifactId>
    </dependency>
    <!-- Servidor WebSocket nativo de Jetty (WebSocketUpgradeHandler) para montar el upgrade
         sobre nuestro Server crudo existente, junto al AuthGateHandler HTTP. -->
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>jetty-websocket-jetty-server</artifactId>
      <version>12.1.7</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.rafex.insightbloom.toolsgateway.GatewayApplication</mainClass>
                </transformer>
              </transformers>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
