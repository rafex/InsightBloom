<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.rafex.insightbloom</groupId>
    <artifactId>insightbloom-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>insightbloom-tools-gateway</artifactId>
  <name>InsightBloom Tools Gateway</name>

  <!--
    Proxy autenticador delante de drawio/Excalidraw/Etherpad (y a futuro Jitsi self-hosted):
    valida sesion de InsightBloom antes de reenviar cualquier request al pod real de la
    herramienta, para que pegar la URL publica directamente (bypaseando el frontend) ya no
    de acceso a nadie sin sesion. Usa solo el Handler de bajo nivel de Jetty 12 (ya cacheado
    transitivamente via ether-http-jetty12) + java.net.http.HttpClient del JDK para el
    reenvio — sin jetty-proxy/jetty-servlet (versiones no compatibles con Jetty 12 core
    disponibles en este entorno).
  -->
  <dependencies>
    <dependency>
      <groupId>dev.rafex.ether.http</groupId>
      <artifactId>ether-http-jetty12</artifactId>
    </dependency>
    <!-- Fase 3b del IDE: parsear la respuesta JSON de /internal/sandbox-target -->
    <dependency>
      <groupId>dev.rafex.ether.json</groupId>
      <artifactId>ether-json</artifactId>
    </dependency>
    <!-- TASK-0020: contratos WebSocketEndpoint/WebSocketSession portables (Etherpad socket.io,
         code-server). El bridge cliente/backend en si (LoggingWebSocketProxyEndpoint) es una
         copia local de ether-websocket-proxy-jetty12 con logging real: ver su javadoc, la
         version publicada en Maven Central traga en silencio cualquier excepcion de la conexion
         saliente al backend, indiagnosticable sin un release nuevo de esa libreria. -->
    <dependency>
      <groupId>dev.rafex.ether.websocket</groupId>
      <artifactId>ether-websocket-core</artifactId>
    </dependency>
    <!-- Servidor WebSocket nativo de Jetty (WebSocketUpgradeHandler) para montar el upgrade
         sobre nuestro Server crudo existente, junto al AuthGateHandler HTTP. -->
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>jetty-websocket-jetty-server</artifactId>
      <version>12.1.7</version>
    </dependency>
    <!-- Cliente WebSocket nativo de Jetty, usado por LoggingWebSocketProxyEndpoint para
         conectar hacia el backend real (Etherpad/code-server). -->
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>jetty-websocket-jetty-client</artifactId>
      <version>12.1.7</version>
    </dependency>
    <!-- Sin esto, SLF4J cae al binding NOP (ver "Defaulting to no-operation (NOP) logger
         implementation" en los logs de arranque) y Jetty pierde en silencio TODOS sus propios
         logs de error internos, posiblemente incluido el motivo real detras del fallo de
         negociacion de WebSocket del IDE (2026-07-17). Puentea a java.util.logging, misma
         infra que ya usa el resto de este servicio (LOGGER de cada clase propia). -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>2.0.17</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- AuthGateHandlerTest necesita mandar el header "Host" (restringido por defecto en
           HttpClient del JDK) para simular distintos hosts virtuales contra el gateway en
           localhost. Antes se seteaba con un bloque static en el propio test, algo fragil: el
           JDK cachea el set de headers restringidos la PRIMERA vez que se evalua, a nivel de
           JVM, asi que si otra clase de test (ej. AppPreviewGateHandlerTest, agregado 2026-07)
           construye un HttpRequest primero, la propiedad seteada despues no tiene efecto y el
           test falla con "restricted header name: Host", confirmado en vivo. Seteandolo aca
           (system property de la JVM de surefire, antes de que cargue cualquier clase de test)
           es independiente del orden de ejecucion.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <jdk.httpclient.allowRestrictedHeaders>host</jdk.httpclient.allowRestrictedHeaders>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- Se reemplazo maven-shade-plugin por maven-assembly-plugin (2026-07-17): agregar
           ServicesResourceTransformer no resolvio el WebSocket "1006" del IDE (verificado en
           vivo, cero cambio). El jar-with-dependencies de assembly-plugin evita por completo
           la clase de bug de "un plugin de empaquetado descarta/fusiona mal recursos de
           servicio compartidos entre JARs", con el trade-off de un empaquetado menos
           configurable (sin relocacion de paquetes ni filtrado fino) que este modulo no
           necesita. containerDescriptorHandlers con metaInf-services sigue fusionando
           META-INF/services/* explicitamente (el problema que se sospechaba real). Ver
           postmortem completo en spec-native/DECISIONS.md, DEC-0022. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.rafex.insightbloom.toolsgateway.GatewayApplication</mainClass>
            </manifest>
          </archive>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
          <appendAssemblyId>false</appendAssemblyId>
          <containerDescriptorHandlers>
            <containerDescriptorHandler>
              <handlerName>metaInf-services</handlerName>
            </containerDescriptorHandler>
          </containerDescriptorHandlers>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
