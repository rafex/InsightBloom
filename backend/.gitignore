# backend/.gitignore — solo exclusiones específicas de backend
# Lo global va en .gitignore del root

# ── Maven build output ────────────────────────────────────────────────────────
**/target/
!**/.mvn/wrapper/maven-wrapper.jar

# ── Archivos generados por herramientas de build ──────────────────────────────
dependency-reduced-pom.xml
**/dependency-reduced-pom.xml

# ── Checkstyle cache ──────────────────────────────────────────────────────────
.checkstyle
checkstyle-cachefile
