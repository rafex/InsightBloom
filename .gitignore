# ═══════════════════════════════════════════════════════════════════════════════
# .gitignore GLOBAL — InsightBloom
# ═══════════════════════════════════════════════════════════════════════════════

# ── Herramientas de IA / agentes ─────────────────────────────────────────────
.claude/
.opencode/
.aider*
.copilot*
.cursor/

# ── Eclipse ───────────────────────────────────────────────────────────────────
.project
.classpath
.settings/
.factorypath
*.prefs
**/.project
**/.classpath
**/.settings/
**/.factorypath
**/bin/
**/.checkstyle

# ── IntelliJ IDEA ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
**/.idea/
**/*.iml
**/*.iws
**/*.ipr
**/out/

# ── NetBeans ──────────────────────────────────────────────────────────────────
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/
**/.vscode/
*.code-workspace

# ── Otros editores ────────────────────────────────────────────────────────────
*.swp
*.swo
*~
*.swn
*.bak
*.orig
\#*\#

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Logs globales ─────────────────────────────────────────────────────────────
*.log
logs/

# ── Bases de datos locales (desarrollo) ──────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Variables de entorno locales ──────────────────────────────────────────────
.env
.env.local
.env.*.local
secrets/

# ── Java / Maven (global) ────────────────────────────────────────────────────
**/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
hs_err_pid*.log
replay_pid*.log
effective-pom.xml

# ── Node / JavaScript ─────────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/
.yarnrc.yml
.pnpm/
.pnpm-store/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
venv/
.venv/
*.egg-info/
dist/
*.egg

# ── Docker ────────────────────────────────────────────────────────────────────
*.tar
*.tar.gz
docker-compose.override.yml
compose.override.yml

# ── Terraform ─────────────────────────────────────────────────────────────────
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# ── Helm ──────────────────────────────────────────────────────────────────────
**/charts/charts/
**/charts/*.lock
**/charts/tmpcharts/

# ── Secretos y certificados ───────────────────────────────────────────────────
*.pem
*.key
*.crt
secrets.yaml
secrets.yml
*-secret.yaml
*-secret.yml
kubeconfig
*.kubeconfig
.kube/

# ── Misceláneos ───────────────────────────────────────────────────────────────
session-ses_*.md
